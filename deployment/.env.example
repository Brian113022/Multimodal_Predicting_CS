# Copy to deployment/.env; fill credentials locally. No shell commands/expansion.
DOMAIN=spinepredict.top
APP_PORT=5050

# Optional: trusted CA bundle, if your Python/proxy requires a custom one.
# Existing certifi is used automatically only when Python has no default CA store.
SSL_CERT_FILE=
SPACESHIP_API_KEY=
SPACESHIP_API_SECRET=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: absolute interpreter from your validated Python environment.
# Otherwise run.sh/run.bat prefer the project .venv, then the active Python.
# PYTHON_EXECUTABLE=
# CLOUDFLARED_PATH=

# Existing webapp config variables (e.g. MUSCLEMAP_PYTHON, RADIOMICS_PYTHON,
# TOTALSEGMENTATOR_PYTHON) can also be supplied here. Keep their validated values.
# Do not put TUNNEL_TOKEN here: setup retrieves and stores it privately.

# Folder holding clinical_features_new.csv, CSA_muscles_features_new.csv and
# radiomics_features_new.csv with patient rows; late-fusion SHAP needs them as
# its reference distribution. data/processed in the repo holds headers only.
# SHAP_BACKGROUND_DIR=
